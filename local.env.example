# Local model server endpoints. The local runner also accepts these as CLI flags.
ANALYSIS_PROVIDER=local
LOCAL_TEXT_PROVIDER=mlx
LOCAL_TEXT_URL=http://127.0.0.1:11234
LOCAL_TEXT_MODEL=ddalcu/Qwen3.8-27B-MLX-Serve-4bit
LOCAL_TEXT_TIMEOUT=300
LOCAL_IMAGE_PROVIDER=mlx
LOCAL_IMAGE_URL=http://127.0.0.1:11234
LOCAL_IMAGE_MODEL=mlx-community/flux2-klein-9b-4bit
LOCAL_IMAGE_TIMEOUT=300
BACKGROUND_PROVIDER=mlx

# 에이전트 모드. agent면 Qwen이 도구를 골라 단계를 실행하고, pipeline이면 기존 고정 순서를 씁니다.
# 텍스트 서버가 tool calling을 지원하지 않으면 pipeline으로 두세요 (docs/internal/agent-tool-calling-smoke.md).
AGENT_MODE=agent
AGENT_MAX_TOOL_CALLS=15
AGENT_TIMEOUT_SECONDS=600
